menu "Example Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config APP_QUIT_PIN
        int "APP Quit button GPIO pin"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
        default 0
        help
            GPIO pin number to be used as APP_QUIT button.

endmenu

menu "ADS-B Receiver"

    # Kconfig has no float type, so these are strings parsed with strtof().
    config ADSB_RX_LAT
        string "Receiver latitude (decimal degrees, north positive)"
        default "29.879221"
        help
            Latitude of the antenna. The radar panel plots bearing and range
            relative to this point. There is no GPS on the board and nothing
            in the ADS-B stream says where the receiver is, so it has to be
            configured here -- a wrong value still renders a perfectly
            plausible-looking display.

    config ADSB_RX_LON
        string "Receiver longitude (decimal degrees, east positive)"
        default "121.649690"
        help
            Longitude of the antenna. See ADSB_RX_LAT.

endmenu

menu "WiFi (ESP32-C6 co-processor)"

    # The board runs permanently in APSTA: the SoftAP serves the in-car case
    # (a phone talks straight to the board) while the STA side reconnects in
    # the background for the fixed-at-home case. See net_wifi.c.

    config ADSB_WIFI_AP_SSID
        string "SoftAP SSID"
        default "ADSB-P4"

    config ADSB_WIFI_AP_PASS
        string "SoftAP password (empty or <8 chars leaves the AP open)"
        default ""
        help
            WPA2-PSK needs at least 8 characters; esp_wifi_set_config()
            rejects a shorter one outright rather than weakening the key, so
            anything shorter is treated as "no password wanted" and the AP
            stays open. Fine on a bench, not on a roof.

    config ADSB_WIFI_AP_CHANNEL
        int "SoftAP channel"
        range 1 13
        default 1

    config ADSB_WIFI_AP_MAX_CONN
        int "SoftAP max associated stations"
        range 1 10
        default 4

    # The upstream (STA) credentials are deliberately NOT Kconfig options.
    # sdkconfig is tracked and this repo's remote is a public fork, so a
    # password put here would be published. They live in NVS instead and are
    # set from the config page at http://192.168.4.1/ -- see net_wifi.c.

    config ADSB_WEB_PORT
        int "Config page / HTTP API port"
        range 1 65535
        default 80

    config ADSB_SSH_PORT
        int "SSH console port"
        range 1 65535
        default 22
        help
            Port the SSH console listens on. The login itself is NOT a Kconfig
            option for the same reason as the WiFi password above -- it lives
            in NVS and is set with `ssh set <user> <pass>` from the serial
            console. With no password stored the server does not listen.

endmenu
