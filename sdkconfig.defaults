# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Default 115200 makes a single TUI redraw (~15-30KB) take 1-3s of blocking
# UART time, which is what starves IDLE1 into a task-watchdog trip. Raise the
# monitor baud rate to match (idf.py monitor -b 921600).
# NOTE: ESP_CONSOLE_UART_BAUDRATE's prompt is only visible/settable when the
# console-select choice is UART_CUSTOM, not UART_DEFAULT -- setting the baud
# alone silently no-ops back to 115200 on reconfigure.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# IDF defaults to -Og. The demod path is a per-sample inner loop (magnitude
# LUT + preamble scan, 2M samples/s), which is exactly the shape -Og costs the
# most on. Assertions are a separate knob and stay on.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Backs the TUI's CPU0/CPU1 gauges. Selects USE_TRACE_FACILITY and
# USE_STATS_FORMATTING_FUNCTIONS on its own; the counter is esp_timer, so
# enabling it costs a 64->32-bit read per context switch and ~1KB of .bss.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Adds TaskStatus_t.xCoreID, which the TASKS panel needs to attribute each
# task to a core.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
