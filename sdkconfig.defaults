# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Default 115200 makes a single TUI redraw (~15-30KB) take 1-3s of blocking
# UART time, which is what starves IDLE1 into a task-watchdog trip. Raise the
# monitor baud rate to match (idf.py monitor -b 921600).
# NOTE: ESP_CONSOLE_UART_BAUDRATE's prompt is only visible/settable when the
# console-select choice is UART_CUSTOM, not UART_DEFAULT -- setting the baud
# alone silently no-ops back to 115200 on reconfigure.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# IDF defaults to -Og. The demod path is a per-sample inner loop (magnitude
# LUT + preamble scan, 2M samples/s), which is exactly the shape -Og costs the
# most on. Assertions are a separate knob and stay on.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Backs the TUI's CPU0/CPU1 gauges. Selects USE_TRACE_FACILITY and
# USE_STATS_FORMATTING_FUNCTIONS on its own; the counter is esp_timer, so
# enabling it costs a 64->32-bit read per context switch and ~1KB of .bss.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Adds TaskStatus_t.xCoreID, which the TASKS panel needs to attribute each
# task to a core.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# The board carries 16 MB (esptool "Detected flash size: 16MB") but the project
# was configured for 2 MB, so 7/8 of it was unreachable and the single-app
# layout capped the app at 1 MB -- too small once lwIP/esp_eth land.
# The bootloader had 0x440 bytes (4%) of its 24K slot left at 0x8000, so the
# table moves to 0x10000 and gives it 56K. Anything that grows the bootloader
# (secure boot, flash encryption, a louder bootloader log) needed that room.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# lwIP's tcpip task is prio 18 and defaults to no affinity, which puts it above
# adsb_rx_task (prio 5) and free to land on core1 -- every packet would then
# preempt the demod loop mid-buffer and drop IQ. Core0 is where the headroom is.
# esp_eth's emac_rx (prio 15) has the same problem and is handled in code
# instead: ETH_MAC_FLAG_PIN_TO_CORE in net_eth.c pins it to the installing core.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
