# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Default 115200 makes a single TUI redraw (~15-30KB) take 1-3s of blocking
# UART time, which is what starves IDLE1 into a task-watchdog trip. Raise the
# monitor baud rate to match (idf.py monitor -b 921600).
# NOTE: ESP_CONSOLE_UART_BAUDRATE's prompt is only visible/settable when the
# console-select choice is UART_CUSTOM, not UART_DEFAULT -- setting the baud
# alone silently no-ops back to 115200 on reconfigure.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# IDF defaults to -Og. The demod path is a per-sample inner loop (magnitude
# LUT + preamble scan, 2M samples/s), which is exactly the shape -Og costs the
# most on. Assertions are a separate knob and stay on.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Backs the TUI's CPU0/CPU1 gauges. Selects USE_TRACE_FACILITY and
# USE_STATS_FORMATTING_FUNCTIONS on its own; the counter is esp_timer, so
# enabling it costs a 64->32-bit read per context switch and ~1KB of .bss.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Adds TaskStatus_t.xCoreID, which the TASKS panel needs to attribute each
# task to a core.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# The board carries 16 MB (esptool "Detected flash size: 16MB") but the project
# was configured for 2 MB, so 7/8 of it was unreachable and the single-app
# layout capped the app at 1 MB -- too small once lwIP/esp_eth land.
# The bootloader had 0x440 bytes (4%) of its 24K slot left at 0x8000, so the
# table moves to 0x10000 and gives it 56K. Anything that grows the bootloader
# (secure boot, flash encryption, a louder bootloader log) needed that room.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# lwIP's tcpip task is prio 18 and defaults to no affinity, which puts it above
# adsb_rx_task (prio 5) and free to land on core1 -- every packet would then
# preempt the demod loop mid-buffer and drop IQ. Core0 is where the headroom is.
# esp_eth's emac_rx (prio 15) has the same problem and is handled in code
# instead: ETH_MAC_FLAG_PIN_TO_CORE in net_eth.c pins it to the installing core.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# ── WiFi via the ESP32-C6 co-processor ──────────────────────────────────────
# The P4 has no radio; esp_wifi_remote remotes the ordinary esp_wifi_* API to
# the C6 over 4-bit SDIO. Pins are read off the schematic and happen to be
# esp_hosted's stock P4 slot-1 defaults, but are spelled out so a component
# default change cannot silently move them. The C6's CHIP_PU reaches P4 GPIO54
# through 0R R78 and is active high.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# PACKET MODE. The slave firmware flashed on the C6 (ESP-Hosted 2.12.6) was
# built with CONFIG_ESP_SDIO_STREAMING_MODE=n, and the two ends must agree: a
# streaming host against a packet slave drops reads silently at sdio_drv.c:959
# and looks exactly like an RPC timeout. See ../c6-notes.md.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_NONE=y

# ── PSRAM ───────────────────────────────────────────────────────────────────
# The part is an ESP32-P4NRW32X: 32 MB of PSRAM inside the package, so this is
# purely a Kconfig question, never a board question. What forced it: internal
# RAM free had fallen to ~46K once WiFi, the HTTP config server and the three
# feeds were all up.
# HEX (16-line) at 200 MHz is what this package is specified for. Both are
# already esp32p4's Kconfig defaults, spelled out so a component default change
# cannot silently move them. Rev 3.x silicon also offers 250M; left alone,
# 200M is the speed proven on this part.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# Puts PSRAM behind ordinary malloc(), not just heap_caps_malloc(SPIRAM).
# Note what this deliberately does NOT change, both left at their defaults:
# SPIRAM_MALLOC_ALWAYSINTERNAL (16K) keeps every small allocation in internal
# RAM, and SPIRAM_MALLOC_RESERVE_INTERNAL (32K) stays reserved for DMA/ISR
# callers -- so no small struct silently lands on a bus that is unreachable
# while the cache is disabled. esp_hosted's SDIO buffers are ~2K and therefore
# stay internal, which is why enabling this does not disturb the C6 link.
CONFIG_SPIRAM_USE_MALLOC=y

# NOT enabled, on purpose:
#   SPIRAM_TRY_ALLOCATE_WIFI_LWIP -- with esp_wifi_remote the WiFi buffers live
#     on the C6; only lwIP's are local, and they are handed to the SDIO DMA.
#     Available headroom if internal RAM ever gets tight again, but it is the
#     kind of change that shows up as rare corruption, so it wants its own run.
#   ESP_HOSTED_DFLT_TASK_FROM_SPIRAM -- task stacks in PSRAM are unreachable
#     while the cache is disabled during a flash write (web_config writes NVS).
#   ESP_HOSTED_MEMPOOL_PREFER_SPIRAM -- does not exist in esp_hosted 2.12.6,
#     which is pinned to the slave firmware; it landed in 2.12.8.
